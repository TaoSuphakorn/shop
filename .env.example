# Copy to .env and fill in. .env is git-ignored: never commit real values.
# Generate each value with:  openssl rand -base64 32

# SQL Server administrator. Must contain upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=
# Password of the least-privilege login "shop_app" that the API uses.
APP_DB_PASSWORD=
# HMAC key for the guest cookie: base64 of at least 32 random bytes.
CART_SIGNING_KEY=
